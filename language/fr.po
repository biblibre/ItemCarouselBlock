#: src/Site/BlockLayout/Carousel.php:180
#: src/Site/BlockLayout/QuerierCarousel.php:194
msgid "Advanced Options"
msgstr "Options avancées"

#: src/Site/BlockLayout/Carousel.php:16
msgid "Item Carousel"
msgstr "Manège à contenus"

#: src/Site/BlockLayout/Carousel.php:44
#: src/Site/BlockLayout/QuerierCarousel.php:46
msgid "Carousel title"
msgstr "Titre du manège"

#: src/Site/BlockLayout/Carousel.php:52
#: src/Site/BlockLayout/QuerierCarousel.php:63
msgid "Items per slide"
msgstr "Ressources par diapositive"

#: src/Site/BlockLayout/Carousel.php:53
#: src/Site/BlockLayout/QuerierCarousel.php:64
msgid "The number of items shown per carousel slide"
msgstr "Le nombre de ressources montrées par diapositive"

#: src/Site/BlockLayout/Carousel.php:65
msgid "Show attachment caption"
msgstr "Afficher la légende de la pièce jointe"

#: src/Site/BlockLayout/Carousel.php:75
msgid "Overlay title/caption"
msgstr "Superposer le titre, la légende"

#: src/Site/BlockLayout/Carousel.php:76
msgid ""
"Place title/caption over image (may require adjusting theme CSS text "
"settings)"
msgstr ""
"Placer le titre, la légende par dessus l’image (peut nécessiter d’ajuster "
"les paramètres du texte dans le CSS du thème)."

#: src/Site/BlockLayout/Carousel.php:86
#: src/Site/BlockLayout/QuerierCarousel.php:76
msgid "Text align"
msgstr "Alignement du texte"

#: src/Site/BlockLayout/Carousel.php:99
#: src/Site/BlockLayout/QuerierCarousel.php:89
msgid "Stretch image"
msgstr "Etirer image"

#: src/Site/BlockLayout/Carousel.php:102
#: src/Site/BlockLayout/QuerierCarousel.php:92
msgid "Fill width"
msgstr "Remplir la largeur"

#: src/Site/BlockLayout/Carousel.php:103
#: src/Site/BlockLayout/QuerierCarousel.php:93
msgid "Fill height"
msgstr "Remplir la hauteur"

#: src/Site/BlockLayout/Carousel.php:104
#: src/Site/BlockLayout/QuerierCarousel.php:94
msgid "Fill entire slide"
msgstr "Remplir la diapositive entière"

#: src/Site/BlockLayout/Carousel.php:113
#: src/Site/BlockLayout/QuerierCarousel.php:103
msgid "Breakpoint"
msgstr "Point d'arrêt"

#: src/Site/BlockLayout/Carousel.php:114
#: src/Site/BlockLayout/QuerierCarousel.php:104
msgid ""
"Display one item per slide when carousel width drops below given pixel "
"width. Adjust for mobile display, carousels with many items per page, etc."
msgstr ""
"Afficher une ressource par diapositive lorsque la largeur du carousel passe "
"sous la largeur donnée Ajuster pour affichage responsive, les carousels avec "
"plusieurs ressources par page, etc."

#: src/Site/BlockLayout/Carousel.php:122
#: src/Site/BlockLayout/QuerierCarousel.php:112
msgid "Auto slide duration"
msgstr "Durée de la diapositive automatique"

#: src/Site/BlockLayout/Carousel.php:123
#: src/Site/BlockLayout/QuerierCarousel.php:113
msgid ""
"Time in milliseconds to pause before auto advance (set to 0 to turn off)"
msgstr ""
"Temps de pause en millisecondes avant de passer à la diapositive suivante "
"automatiquement (définir à 0 pour désactiver)."

#: src/Site/BlockLayout/Carousel.php:131
#: src/Site/BlockLayout/QuerierCarousel.php:121
msgid "Infinite loop"
msgstr "Boucle infinie"

#: src/Site/BlockLayout/Carousel.php:150
#: src/Site/BlockLayout/QuerierCarousel.php:140
msgid "Fade between slides"
msgstr "Fondu entre les diapositives"

#: src/Site/BlockLayout/Carousel.php:151
#: src/Site/BlockLayout/QuerierCarousel.php:141
msgid "Note: only works with 1 item per slide"
msgstr "Note: fonctionne seulement si il y a une ressource par diapositive"

#: src/Site/BlockLayout/QuerierCarousel.php:17
msgid "Item Carousel based on query"
msgstr "Manège à contenus basé sur une requête"

#: src/Site/BlockLayout/QuerierCarousel.php:54
msgid "Specify resources in query"
msgstr "Spécifier les ressources dans la requête"

#: src/Site/BlockLayout/QuerierCarousel.php:55
msgid "Build or type a url query to select resources"
msgstr "Construire ou saisir une requête url pour sélectionner des ressources"

#: src/Site/BlockLayout/QuerierCarousel.php:154
msgid "Minimal number of resources to display carousel"
msgstr "Nombre minimal de ressources pour afficher le carousel"

#: src/Site/BlockLayout/QuerierCarousel.php:166
msgid "Maximum number of resources to display carousel"
msgstr "Nombre maximal de ressources pour afficher le carousel"
